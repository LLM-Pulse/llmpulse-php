{
    "name": "llmpulse/sdk",
    "description": "REST API client for LLM Pulse AI visibility analytics.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/LLM-Pulse/llmpulse-php",
    "license": "MIT",
    "authors": [
        {
            "name": "LLM Pulse",
            "homepage": "https://llmpulse.ai"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "LLMPulse\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "LLMPulse\\Test\\" : "test/" }
    }
}
